# ===================================================
# CONFIGURAÇÃO DE AMBIENTE - USSD BOT VODACOM (NODE.JS)
# ===================================================
# IMPORTANTE: Copie este arquivo para ".env" e preencha as variáveis secretas.
# NUNCA envie o arquivo ".env" real para o GitHub.

# Porta do Servidor HTTP Local (3000 para Produção / 3001 para Testes)
PORT=3000

# Ambiente de Execução (production / development)
NODE_ENV=production

# Nome do Bot no WhatsApp
BOT_NAME="USSD Bot Vodacom"

# Pasta de Armazenamento da Sessão do WhatsApp (Baileys)
SESSION_PATH="auth_info_baileys"

# URL Oficial do Firebase Realtime Database
FIREBASE_DATABASE_URL="https://seu-projeto-default-rtdb.firebaseio.com"
FIREBASE_DB_URL="https://seu-projeto-default-rtdb.firebaseio.com"

# Project ID do Google Firebase
FIREBASE_PROJECT_ID="ussd-bot-vodacom"

# Token Secreto de Autenticação entre a VPS e o App Android
API_SECRET_TOKEN="ussd_bot_secure_token_2026"

# Endereço da VPS (Webhook)
ORACLE_VPS_URL="http://seu-ip-da-vps:3000"
