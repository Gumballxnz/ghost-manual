# ===================================================
# CONFIGURAÇÃO DE AMBIENTE - GHOST BOT MANUAL
# ===================================================

PORT=3000
NODE_ENV=production

# Opcional: Se desejar sincronizar dados na nuvem (Firebase Realtime Database)
